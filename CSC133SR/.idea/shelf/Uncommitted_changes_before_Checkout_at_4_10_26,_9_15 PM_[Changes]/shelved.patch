--- a/src/main/java/pkgSrRenderEngine/SrCamera.java	(revision fa0c2132697ceaff26da957e5d3cfa58349670d4)
+++ /dev/null	(revision fa0c2132697ceaff26da957e5d3cfa58349670d4)
@@ -1,89 +0,0 @@
-package pkgSrRenderEngine;
-
-import org.joml.Matrix4f;
-import org.joml.Vector3f;
-
-public class SrCamera {
-
-    protected Matrix4f projectionMatrix;
-    protected Matrix4f viewMatrix;
-
-    protected Vector3f defaultLookAt;
-    protected Vector3f defaultLookFrom;
-    protected Vector3f defaultUpVector;
-
-    protected Vector3f curLookAt;
-    protected Vector3f curLookFrom;
-    protected Vector3f curUpVector;
-
-    private final float left, right, bottom, top, near, far;
-
-    public SrCamera(float left, float right, float bottom, float top,
-                    float near, float far, Vector3f upVector) {
-        this.left   = left;
-        this.right  = right;
-        this.bottom = bottom;
-        this.top    = top;
-        this.near   = near;
-        this.far    = far;
-
-        defaultUpVector = new Vector3f(upVector);
-        curUpVector     = new Vector3f(upVector);
-
-        // Default camera sits at origin, looks along -z (2-D ortho scene)
-        defaultLookFrom = new Vector3f(0f, 0f, 0f);
-        defaultLookAt   = new Vector3f(0f, 0f, -1f);
-
-        curLookFrom = new Vector3f(defaultLookFrom);
-        curLookAt   = new Vector3f(defaultLookAt);
-
-        // Compute matrices eagerly — no OpenGL calls, pure JOML math
-        setOrthoProjection();
-        initCamera();
-    }  //  SrCamera(...)
-
-    // ---------------------------------------------------------------
-    // Matrix setup
-    // ---------------------------------------------------------------
-
-    public void setOrthoProjection() {
-        projectionMatrix = new Matrix4f().setOrtho(left, right, bottom, top, near, far);
-    }  //  setOrthoProjection()
-
-    public void initCamera() {
-        viewMatrix = new Matrix4f().lookAt(curLookFrom, curLookAt, curUpVector);
-    }  //  initCamera()
-
-    // ---------------------------------------------------------------
-    // Getters — return clones so callers cannot mutate internals
-    // ---------------------------------------------------------------
-
-    public final Vector3f getCurLookAt() {
-        return new Vector3f(curLookAt);
-    }
-
-    public final Vector3f getCurLookFrom() {
-        return new Vector3f(curLookFrom);
-    }
-
-    public final Matrix4f getViewMatrix() {
-        return new Matrix4f(viewMatrix);
-    }
-
-    public final Matrix4f getProjectionMatrix() {
-        return new Matrix4f(projectionMatrix);
-    }
-
-    // ---------------------------------------------------------------
-    // Setters
-    // ---------------------------------------------------------------
-
-    public void setCurLookAt(Vector3f v) {
-        curLookAt = new Vector3f(v);
-    }
-
-    public void setCurLookFrom(Vector3f v) {
-        curLookFrom = new Vector3f(v);
-    }
-
-}  //  public class SrCamera
