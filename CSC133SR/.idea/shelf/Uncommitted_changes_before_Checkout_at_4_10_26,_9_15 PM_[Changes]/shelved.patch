diff --git a/src/main/java/pkgSrRenderEngine/SrVertexDataManager.java b/src/main/java/pkgSrRenderEngine/SrVertexDataManager.java
deleted file mode 100644
--- a/src/main/java/pkgSrRenderEngine/SrVertexDataManager.java	(revision fa0c2132697ceaff26da957e5d3cfa58349670d4)
+++ /dev/null	(revision fa0c2132697ceaff26da957e5d3cfa58349670d4)
@@ -1,99 +0,0 @@
-package pkgSrRenderEngine;
-
-import org.joml.Vector4f;
-
-public class SrVertexDataManager {
-
-    private static final int vertexStride = 9;  // floats per vertex: x y z u v R G B A
-
-    private int     nextIIndex;
-    private int     nextVCIndex;
-    private int     nextVCount;
-    private float[] vertexArray;
-    private float[] defaultColors;
-    private int[]   indexArray;
-
-    // Explicit sizes — used when caller knows counts up front
-    SrVertexDataManager(int vaSize, int iaSize) {
-        vertexArray   = new float[vaSize];
-        indexArray    = new int[iaSize];
-        defaultColors = new float[4];
-        nextVCIndex   = 0;
-        nextIIndex    = 0;
-    }
-
-    // Sizes arrays from a data reader; vertex data is filled later by the renderer
-    SrVertexDataManager(SrVertexDataReader reader) {
-        int numVerts  = reader.getNumVertices();
-        vertexArray   = new float[numVerts * vertexStride];
-        indexArray    = new int[numVerts];
-        defaultColors = new float[4];
-        nextVCIndex   = 0;
-        nextIIndex    = 0;
-    }
-
-    // ---------------------------------------------------------------
-    // Accessors
-    // ---------------------------------------------------------------
-
-    protected float[] getVertexArray()     { return vertexArray; }
-    protected int[]   getIndexArray()      { return indexArray; }
-    protected int     getVertexArrayLength() { return vertexArray.length; }
-
-    // ---------------------------------------------------------------
-    // Reset helpers
-    // ---------------------------------------------------------------
-
-    protected void resetNextIIndex()  { nextIIndex  = 0; }
-    protected void resetNextVCIndex() { nextVCIndex = 0; }
-    protected void resetNextVcount()  { nextVCount  = 0; }
-
-    protected void resetIndexArray()  { indexArray  = new int[indexArray.length]; }
-    protected void resetVertexArray() { vertexArray = new float[vertexArray.length]; }
-
-    // ---------------------------------------------------------------
-    // Color default
-    // ---------------------------------------------------------------
-
-    protected void setDefaultColor(Vector4f myC) {
-        defaultColors[0] = myC.x;
-        defaultColors[1] = myC.y;
-        defaultColors[2] = myC.z;
-        defaultColors[3] = myC.w;
-    }
-
-    // ---------------------------------------------------------------
-    // Geometry fill
-    // ---------------------------------------------------------------
-
-    protected int fillTriangleVertexCoordinates(
-            float x0, float y0, float u0, float v0,
-            float x1, float y1, float u1, float v1,
-            float x2, float y2, float u2, float v2) {
-
-        int baseVertex = nextVCIndex / vertexStride;
-
-        putVertex(x0, y0, 0f, u0, v0);
-        putVertex(x1, y1, 0f, u1, v1);
-        putVertex(x2, y2, 0f, u2, v2);
-
-        indexArray[nextIIndex++] = baseVertex;
-        indexArray[nextIIndex++] = baseVertex + 1;
-        indexArray[nextIIndex++] = baseVertex + 2;
-
-        return baseVertex;
-    }
-
-    private void putVertex(float x, float y, float z, float u, float v) {
-        vertexArray[nextVCIndex++] = x;
-        vertexArray[nextVCIndex++] = y;
-        vertexArray[nextVCIndex++] = z;
-        vertexArray[nextVCIndex++] = u;
-        vertexArray[nextVCIndex++] = v;
-        vertexArray[nextVCIndex++] = defaultColors[0];
-        vertexArray[nextVCIndex++] = defaultColors[1];
-        vertexArray[nextVCIndex++] = defaultColors[2];
-        vertexArray[nextVCIndex++] = defaultColors[3];
-    }
-
-}  //  public class SrVertexDataManager
